ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_SECRET=gere-uma-string-aleatoria-com-32-caracteres-ou-mais
# Usada pelo botao "Buscar dados" no admin de produtos (importar produto por link)
# Pegue gratis em https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Opcional: plano B usado automaticamente se o Groq falhar/travar.
# Pegue gratis em https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Rastreamento de cliques em link de afiliado (todos opcionais, sem nenhum configurado
# o site funciona normal, so sem os pixels). Prefixo VITE_ e obrigatorio - sao publicas,
# embutidas no bundle do navegador no build, nao sao segredo.
# GA4: Admin > Fluxos de dados > seu fluxo > "ID de mediçao" (formato G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-...
# Google Ads: Ferramentas > Conversoes > sua conversao > "Tag do Google" (formato AW-XXXXXXXXX)
VITE_GOOGLE_ADS_ID=AW-...
# Google Ads: mesma tela, ID completo da conversao (formato AW-XXXXXXXXX/XxxXXXXxxXXXXxxXXXXx)
VITE_GOOGLE_ADS_CONVERSION_ID=AW-.../...
# Meta Events Manager > sua fonte de dados > "ID do Pixel"
VITE_META_PIXEL_ID=...
# Blob Store PUBLICO separado do BLOB_READ_WRITE_TOKEN (que e privado, guarda o catalogo).
# Criado via `vercel blob create-store <nome> --access public`, conectado ao projeto
# manualmente no dashboard da Vercel com esse nome de variavel.
BLOB_IMAGES_READ_WRITE_TOKEN=vercel_blob_rw_...
